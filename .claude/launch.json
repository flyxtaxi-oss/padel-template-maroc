{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "padel-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/.bin/next",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "padel-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/.bin/next",
        "start"
      ],
      "autoPort": true
    }
  ]
}
