# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Réglages Claude Code propres à la machine
.claude/settings.local.json

# Journal du CLI Firebase (détails de requêtes : ne jamais committer)
firebase-debug.log

# Captures et journaux du navigateur de test
.playwright-mcp/

# Vidéos brutes générées par scripts/higgsfield.mjs (avant sélection et encodage)
/.higgsfield/

# Réglages « Mon club » en développement local (sans Firebase)
/.data/

# Livrables client (propositions, PDF) : confidentiels, dépôt public
/output/
